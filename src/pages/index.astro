  </main>
  <script>
    const heroMenuButton = document.querySelector<HTMLButtonElement>('.hero-mobile-menu');
    const heroNavigation = document.querySelector<HTMLElement>('#hero-navigation');
    if (heroMenuButton && heroNavigation) {
      heroMenuButton.addEventListener('click', () => {
        const isOpen = heroMenuButton.getAttribute('aria-expanded') === 'true';
        heroMenuButton.setAttribute('aria-expanded', String(!isOpen));
        heroMenuButton.setAttribute('aria-label', isOpen ? 'Open navigation' : 'Close navigation');
        heroNavigation.classList.toggle('is-mobile-open', !isOpen);
      });
      heroNavigation.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        heroMenuButton.setAttribute('aria-expanded', 'false');
        heroMenuButton.setAttribute('aria-label', 'Open navigation');
        heroNavigation.classList.remove('is-mobile-open');
      }));
    }

    const globalMenuWrap = document.querySelector<HTMLElement>('.site-menu-wrap');
    const heroSection = document.querySelector<HTMLElement>('.hero-section');
    if (globalMenuWrap && heroSection && 'IntersectionObserver' in window) {
      const menuObserver = new IntersectionObserver(([entry]) => {
        globalMenuWrap.classList.toggle('is-visible', !entry.isIntersecting);
      }, { threshold: 0.08 });
      menuObserver.observe(heroSection);
    }

    const menuButton = document.querySelector<HTMLButtonElement>('.work-menu-button');
    const menu = document.querySelector<HTMLElement>('#work-menu');
    if (menuButton && menu) {
      menuButton.addEventListener('click', () => {
        const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!isOpen));
        menu.hidden = isOpen;
      });
      document.addEventListener('click', (event) => {
        if (!menuButton.contains(event.target as Node) && !menu.contains(event.target as Node)) {
          menuButton.setAttribute('aria-expanded', 'false');
          menu.hidden = true;
        }
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          menuButton.setAttribute('aria-expanded', 'false');
          menu.hidden = true;
          menuButton.focus();
        }
      });
    }

    const preview = document.querySelector<HTMLElement>('.project-follow-preview');
    const previewImage = preview?.querySelector('img');
    const rows = document.querySelectorAll<HTMLElement>('.project-row');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    if (preview && previewImage && finePointer.matches) {
      rows.forEach((row) => {
        row.addEventListener('pointerenter', () => {
          const source = row.dataset.preview;
          if (source) previewImage.src = source;
          preview.classList.add('is-visible');
          rows.forEach((item) => item.classList.toggle('is-active', item === row));
        });
        row.addEventListener('pointermove', (event) => {
          preview.style.left = `${event.clientX + 28}px`;
          preview.style.top = `${event.clientY + 24}px`;
        });
        row.addEventListener('pointerleave', () => {
          preview.classList.remove('is-visible');
          row.classList.remove('is-active');
        });
      });
    }
  </script>
</BaseLayout>
