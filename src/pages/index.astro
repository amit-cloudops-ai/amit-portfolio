---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Amit Madakatti — Cloud & DevOps Engineer"
  description="Amit Madakatti is a Cloud and DevOps Engineer building automated, secure and scalable infrastructure on AWS."
>
  <main class="hero-page">
    <section class="hero-section" aria-labelledby="hero-title">
      <header class="hero-nav">
        <a class="nav-left" href="/" aria-label="Amit Madakatti home">Amit Madakatti</a>
        <nav class="nav-right" aria-label="Main navigation">
          <a href="/work/">Work</a>
          <a href="/about/">Story</a>
          <a href="mailto:amitpm.work@gmail.com" class="project-pill">Let’s talk</a>
        </nav>
      </header>

      <div class="hero-stage">
        <h1 class="hero-role" id="hero-title">Cloud and DevOps engineer<br />building on AWS</h1>

        <div class="hero-status">
          <div class="status-line"><span class="status-dot"></span><span>Open to DevOps and Cloud roles</span></div>
          <p>Based in Karnataka, India</p>
        </div>

        <figure class="portrait">
          <img src="/images/amit-portrait-placeholder.svg" alt="Portrait of Amit Madakatti" fetchpriority="high" />
        </figure>

        <div class="name-layer" aria-hidden="true">
          <span>Amit Madakatti · Amit Madakatti ·</span>
        </div>
        <div class="name-layer name-layer-on-photo" aria-hidden="true">
          <span>Amit Madakatti · Amit Madakatti ·</span>
        </div>
      </div>

      <p class="hero-promise">
        I build cloud platforms that ship safely, and I stay on until they’re running in production.
      </p>

      <a class="story-button" href="/about/" aria-label="Read my story">
        <span>My story</span><span class="story-arrow" aria-hidden="true">↗</span>
      </a>
    </section>
  </main>
</BaseLayout>
