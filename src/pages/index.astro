---
import BaseLayout from '../layouts/BaseLayout.astro';
import NameTicker from '../components/NameTicker';
---
<BaseLayout title="Amit Madakatti — Cloud & DevOps Engineer" description="Amit Madakatti is a Cloud and DevOps Engineer building automated, secure and scalable infrastructure on AWS.">
  <main class="hero-page">
    <section class="hero-section" aria-labelledby="hero-title">
      <header class="hero-nav">
        <a class="nav-left" href="/" aria-label="Amit Madakatti home">Amit Madakatti</a>
        <nav class="nav-right" id="hero-navigation" aria-label="Main navigation">
          <a href="#selected-work">Work</a><a href="/about/">Story</a>
          <a href="mailto:amitpm.work@gmail.com" class="project-pill">Let’s talk</a>
        </nav>
        <button class="hero-mobile-menu" type="button" aria-expanded="false" aria-controls="hero-navigation" aria-label="Open navigation">
          <span></span><span></span>
        </button>
      </header>
      <div class="hero-stage">
        <h1 class="hero-role" id="hero-title">Cloud and DevOps engineer<br />building on AWS</h1>
        <div class="hero-status">
          <div class="status-line"><span class="status-dot" aria-hidden="true"></span><span>Open to DevOps and Cloud roles</span></div>
          <p>Based in Karnataka, India</p>
        </div>
        <figure class="portrait">
          <img src="/images/amit-hero.webp" alt="Amit Madakatti, Cloud and DevOps Engineer" fetchpriority="high" />
        </figure>
        <NameTicker client:load />
      </div>
      <p class="hero-promise">I build automated, secure AWS infrastructure, and I stay on until it runs without drama.</p>
      <a class="story-button" href="/about/" aria-label="Read my story"><span>My story</span></a>
    </section>

    <section class="selected-work" id="selected-work" aria-labelledby="work-title">
      <div class="work-heading">
        <div class="work-heading-copy">
          <p class="section-kicker">SELECTED WORK / 2024—26</p>
          <h2 id="work-title">Systems built<br />to <span>run.</span></h2>
        </div>
        <div class="work-menu-wrap">
          <button class="work-menu-button" type="button" aria-expanded="false" aria-controls="work-menu" aria-label="Open section menu">
            <span class="menu-glyph" aria-hidden="true"><i></i><i></i></span>
          </button>
          <nav class="work-menu" id="work-menu" aria-label="Section menu" hidden>
            <a href="/">Home <span>01</span></a>
            <a href="/about/">About <span>02</span></a>
            <a href="mailto:amitpm.work@gmail.com">Contact <span>03</span></a>
          </nav>
        </div>
      </div>

      <div class="work-intro">
        <p>Infrastructure, delivery and reliability — from the network edge to the release pipeline.</p>
        <span>04 PROJECTS <b>↘</b></span>
      </div>

      <div class="project-list">
        <a class="project-row" href="/work/progressive-delivery/" data-preview="/images/projects/progressive-delivery-platform.svg" aria-label="View Progressive Delivery Platform case study">
          <span class="project-index">01</span>
          <span class="project-main"><span class="project-type">KUBERNETES / PLATFORM ENGINEERING</span><span class="project-name">Progressive Delivery Platform</span><span class="project-mobile-image" aria-hidden="true"><img src="/images/projects/progressive-delivery-platform.svg" alt="" loading="lazy" /></span><span class="project-summary">A self-healing release platform built around GitOps, canary analysis and automated rollback.</span></span>
          <span class="project-stack">AWS · EKS · ARGO CD · TERRAFORM</span>
          <span class="project-open" aria-hidden="true">↗</span>
        </a>
        <a class="project-row" href="/work/employee-onboarding/" data-preview="/images/projects/employee-onboarding-service.svg" aria-label="View Employee Onboarding and Identity Service case study">
          <span class="project-index">02</span>
          <span class="project-main"><span class="project-type">SERVERLESS / IDENTITY AUTOMATION</span><span class="project-name">Employee Onboarding &amp; Identity</span><span class="project-mobile-image" aria-hidden="true"><img src="/images/projects/employee-onboarding-service.svg" alt="" loading="lazy" /></span><span class="project-summary">An AWS onboarding system connecting employee identity, workflow orchestration and document handling.</span></span>
          <span class="project-stack">AWS · COGNITO · STEP FUNCTIONS</span>
          <span class="project-open" aria-hidden="true">↗</span>
        </a>
        <a class="project-row" href="/work/three-tier-aws/" data-preview="/images/projects/three-tier-web-app.svg" aria-label="View Three-Tier Web Application case study">
          <span class="project-index">03</span>
          <span class="project-main"><span class="project-type">CLOUD NETWORKING / WEB ARCHITECTURE</span><span class="project-name">Three-Tier AWS Application</span><span class="project-mobile-image" aria-hidden="true"><img src="/images/projects/three-tier-web-app.svg" alt="" loading="lazy" /></span><span class="project-summary">A segmented AWS network separating the public entry point, application runtime and data layer.</span></span>
          <span class="project-stack">AWS · VPC · EC2 · RDS</span>
          <span class="project-open" aria-hidden="true">↗</span>
        </a>
        <a class="project-row" href="/work/zero-downtime-api/" data-preview="/images/projects/zero-downtime-api-deployment.svg" aria-label="View Zero-Downtime API Deployments case study">
          <span class="project-index">04</span>
          <span class="project-main"><span class="project-type">RELEASE ENGINEERING / SERVERLESS</span><span class="project-name">Zero-Downtime API Deployments</span><span class="project-mobile-image" aria-hidden="true"><img src="/images/projects/zero-downtime-api-deployment.svg" alt="" loading="lazy" /></span><span class="project-summary">Blue-green environments and controlled canary traffic for safer API releases.</span></span>
          <span class="project-stack">API GATEWAY · LAMBDA · CLOUDWATCH</span>
          <span class="project-open" aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="work-archive-cta">
        <a class="see-all-work" href="/work/">See all work <span aria-hidden="true">↗</span></a>
      </div>

      <div class="work-marquee" aria-label="Architecture diagrams from the featured projects">
        <div class="marquee-window">
          <div class="marquee-track">
            <div class="marquee-group">
              <img src="/images/projects/progressive-delivery-platform.svg" alt="" aria-hidden="true" />
              <img src="/images/projects/employee-onboarding-service.svg" alt="" aria-hidden="true" />
              <img src="/images/projects/three-tier-web-app.svg" alt="" aria-hidden="true" />
              <img src="/images/projects/zero-downtime-api-deployment.svg" alt="" aria-hidden="true" />
            </div>
            <div class="marquee-group" aria-hidden="true">
              <img src="/images/projects/progressive-delivery-platform.svg" alt="" />
              <img src="/images/projects/employee-onboarding-service.svg" alt="" />
              <img src="/images/projects/three-tier-web-app.svg" alt="" />
              <img src="/images/projects/zero-downtime-api-deployment.svg" alt="" />
            </div>
          </div>
        </div>
      </div>

      <div class="work-bottom">
        <span>BUILT WITH INTENT. OPERATED WITH CARE.</span>
        <a href="https://github.com/amit-cloudops-ai" target="_blank" rel="noreferrer">MORE ON GITHUB <span>↗</span></a>
      </div>
      <div class="project-follow-preview" aria-hidden="true"><img src="/images/projects/progressive-delivery-platform.svg" alt="" /></div>
    </section>

    <section class="skills-section" id="skills" aria-labelledby="skills-title">
      <div class="skills-layout">
        <header class="skills-heading">
          <p class="section-kicker">CAPABILITIES / TOOLKIT</p>
          <h2 id="skills-title">What I work<br />with<span>.</span></h2>
          <p class="skills-intro">The tools I use to build, automate and operate cloud infrastructure — and the technologies I'm actively exploring.</p>
        </header>

        <div class="skills-content">
          <div class="skill-group">
            <div class="skill-group-heading"><span class="skill-number">01</span><h3>Cloud infrastructure</h3></div>
            <div class="skill-items">
              <span class="skill-item skill-featured"><img src="https://cdn.simpleicons.org/amazonaws/232F3E" alt="" loading="lazy" />Amazon Web Services</span>
              <span class="skill-item">EC2</span><span class="skill-item">VPC</span><span class="skill-item">IAM</span><span class="skill-item">S3</span><span class="skill-item">RDS</span><span class="skill-item">DynamoDB</span><span class="skill-item">Lambda</span><span class="skill-item">API Gateway</span><span class="skill-item">ECS &amp; Fargate</span><span class="skill-item">CloudFront</span><span class="skill-item">Route 53</span><span class="skill-item">Step Functions</span><span class="skill-item">Cognito</span><span class="skill-item">SNS</span><span class="skill-item">SES</span><span class="skill-item">Secrets Manager</span><span class="skill-item">CloudWatch</span>
            </div>
          </div>

          <div class="skill-group">
            <div class="skill-group-heading"><span class="skill-number">02</span><h3>Containers &amp; orchestration</h3></div>
            <div class="skill-items">
              <span class="skill-item"><img src="https://cdn.simpleicons.org/docker/2496ED" alt="" loading="lazy" />Docker</span>
              <span class="skill-item"><img src="https://cdn.simpleicons.org/kubernetes/326CE5" alt="" loading="lazy" />Kubernetes</span>
              <span class="skill-item"><img src="https://cdn.simpleicons.org/amazoneks/FF9900" alt="" loading="lazy" />Amazon EKS</span>
              <span class="skill-item">Karpenter</span><span class="skill-item">Gateway API</span><span class="skill-item">Ingress</span>
            </div>
          </div>

          <div class="skill-group">
            <div class="skill-group-heading"><span class="skill-number">03</span><h3>Infrastructure as code</h3></div>
            <div class="skill-items">
              <span class="skill-item"><img src="https://cdn.simpleicons.org/terraform/844FBA" alt="" loading="lazy" />Terraform</span>
              <span class="skill-item"><img src="https://cdn.simpleicons.org/amazoncloudformation/FF9900" alt="" loading="lazy" />CloudFormation</span>
              <span class="skill-item"><img src="https://cdn.simpleicons.org/ansible/EE0000" alt="" loading="lazy" />Ansible</span>
            </div>
          </div>

          <div class="skill-group">
            <div class="skill-group-heading"><span class="skill-number">04</span><h3>CI/CD &amp; GitOps</h3></div>
            <div class="skill-items">
              <span class="skill-item"><img src="https://cdn.simpleicons.org/git/F05032" alt="" loading="lazy" />Git</span>
              <span class="skill-item"><img src="https://cdn.simpleicons.org/githubactions/2088FF" alt="" loading="lazy" />GitHub Actions</span>
              <span class="skill-item"><img src="https://cdn.simpleicons.org/jenkins/D24939" alt="" loading="lazy" />Jenkins</span>
              <span class="skill-item"><img src="https://cdn.simpleicons.org/argo/EF7B4D" alt="" loading="lazy" />Argo CD</span>
              <span class="skill-item">Argo Rollouts</span>
            </div>
          </div>

          <div class="skill-group">
            <div class="skill-group-heading"><span class="skill-number">05</span><h3>Observability</h3></div>
            <div class="skill-items">
              <span class="skill-item"><img src="https://cdn.simpleicons.org/prometheus/E6522C" alt="" loading="lazy" />Prometheus</span>
              <span class="skill-item"><img src="https://cdn.simpleicons.org/grafana/F46800" alt="" loading="lazy" />Grafana</span>
              <span class="skill-item">Loki</span><span class="skill-item">Alertmanager</span>
              <span class="skill-item"><img src="https://cdn.simpleicons.org/opentelemetry/000000" alt="" loading="lazy" />OpenTelemetry</span>
              <span class="skill-item"><img src="https://cdn.simpleicons.org/jaeger/60D0E4" alt="" loading="lazy" />Jaeger</span>
            </div>
          </div>

          <div class="skill-group">
            <div class="skill-group-heading"><span class="skill-number">06</span><h3>Security</h3></div>
            <div class="skill-items">
              <span class="skill-item">IAM least privilege</span><span class="skill-item">Security Groups</span><span class="skill-item">Secrets management</span><span class="skill-item">Policy as code</span>
            </div>
          </div>

          <div class="skill-group">
            <div class="skill-group-heading"><span class="skill-number">07</span><h3>Linux &amp; networking</h3></div>
            <div class="skill-items">
              <span class="skill-item"><img src="https://cdn.simpleicons.org/linux/FCC624" alt="" loading="lazy" />Linux</span>
              <span class="skill-item"><img src="https://cdn.simpleicons.org/gnubash/4EAA25" alt="" loading="lazy" />Bash</span>
              <span class="skill-item">DNS</span><span class="skill-item">TCP/IP</span><span class="skill-item">Subnetting</span>
              <span class="skill-item"><img src="https://cdn.simpleicons.org/nginx/009639" alt="" loading="lazy" />Nginx</span>
            </div>
          </div>

          <div class="skill-group">
            <div class="skill-group-heading"><span class="skill-number">08</span><h3>Reliability engineering</h3></div>
            <div class="skill-items">
              <span class="skill-item">Incident response</span><span class="skill-item">Runbooks</span><span class="skill-item">SLOs</span><span class="skill-item">Alerting</span><span class="skill-item">Rollback strategy</span>
            </div>
          </div>

          <div class="skill-group skill-group-emerging">
            <div class="skill-group-heading"><span class="skill-number">09</span><h3>AI &amp; agent systems <span class="skill-emerging-label">Exploring</span></h3></div>
            <div class="skill-items">
              <span class="skill-item"><img src="https://cdn.simpleicons.org/anthropic/D97757" alt="" loading="lazy" />Claude API</span>
              <span class="skill-item"><img src="https://cdn.simpleicons.org/openai/412991" alt="" loading="lazy" />OpenAI API</span>
              <span class="skill-item">Tool calling</span><span class="skill-item">MCP</span>
              <span class="skill-item"><img src="https://cdn.simpleicons.org/langchain/1C3C3C" alt="" loading="lazy" />LangGraph</span>
              <span class="skill-item">RAG basics</span><span class="skill-item">Amazon Bedrock</span><span class="skill-item">Guardrails &amp; approval gates</span><span class="skill-item">Agent evaluation</span><span class="skill-item">Token &amp; cost control</span>
            </div>
          </div>

          <div class="skill-group">
            <div class="skill-group-heading"><span class="skill-number">10</span><h3>Programming &amp; interfaces</h3></div>
            <div class="skill-items">
              <span class="skill-item"><img src="https://cdn.simpleicons.org/python/3776AB" alt="" loading="lazy" />Python</span>
              <span class="skill-item">YAML</span><span class="skill-item">JSON</span><span class="skill-item">SQL</span><span class="skill-item">REST APIs</span>
            </div>
          </div>

          <div class="certification-strip">
            <div><p class="cert-kicker">CERTIFICATION</p><h3>AWS Certified Cloud Practitioner</h3></div>
            <span class="cert-status">IN PROGRESS <i aria-hidden="true">↗</i></span>
          </div>
        </div>
      </div>
    </section>
  </main>
  <script>
    const heroMenuButton = document.querySelector<HTMLButtonElement>('.hero-mobile-menu');
    const heroNavigation = document.querySelector<HTMLElement>('#hero-navigation');
    if (heroMenuButton && heroNavigation) {
      heroMenuButton.addEventListener('click', () => {
        const isOpen = heroMenuButton.getAttribute('aria-expanded') === 'true';
        heroMenuButton.setAttribute('aria-expanded', String(!isOpen));
        heroMenuButton.setAttribute('aria-label', isOpen ? 'Open navigation' : 'Close navigation');
        heroNavigation.classList.toggle('is-mobile-open', !isOpen);
      });
      heroNavigation.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        heroMenuButton.setAttribute('aria-expanded', 'false');
        heroMenuButton.setAttribute('aria-label', 'Open navigation');
        heroNavigation.classList.remove('is-mobile-open');
      }));
    }

    const workMenuWrap = document.querySelector<HTMLElement>('.work-menu-wrap');
    const selectedWorkSection = document.querySelector<HTMLElement>('#selected-work');
    if (workMenuWrap && selectedWorkSection && 'IntersectionObserver' in window) {
      const workObserver = new IntersectionObserver(([entry]) => {
        workMenuWrap.classList.toggle('is-active', entry.isIntersecting);
      }, { threshold: 0.04 });
      workObserver.observe(selectedWorkSection);
    }

    const menuButton = document.querySelector<HTMLButtonElement>('.work-menu-button');
    const menu = document.querySelector<HTMLElement>('#work-menu');
    if (menuButton && menu) {
      menuButton.addEventListener('click', () => {
        const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!isOpen));
        menu.hidden = isOpen;
      });
      document.addEventListener('click', (event) => {
        if (!menuButton.contains(event.target as Node) && !menu.contains(event.target as Node)) {
          menuButton.setAttribute('aria-expanded', 'false');
          menu.hidden = true;
        }
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          menuButton.setAttribute('aria-expanded', 'false');
          menu.hidden = true;
          menuButton.focus();
        }
      });
    }

    const preview = document.querySelector<HTMLElement>('.project-follow-preview');
    const previewImage = preview?.querySelector('img');
    const rows = document.querySelectorAll<HTMLElement>('.project-row');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    if (preview && previewImage && finePointer.matches) {
      rows.forEach((row) => {
        row.addEventListener('pointerenter', () => {
          const source = row.dataset.preview;
          if (source) previewImage.src = source;
          preview.classList.add('is-visible');
          rows.forEach((item) => item.classList.toggle('is-active', item === row));
        });
        row.addEventListener('pointermove', (event) => {
          preview.style.left = `${event.clientX + 28}px`;
          preview.style.top = `${event.clientY + 24}px`;
        });
        row.addEventListener('pointerleave', () => {
          preview.classList.remove('is-visible');
          row.classList.remove('is-active');
        });
      });
    }
  </script>
</BaseLayout>
