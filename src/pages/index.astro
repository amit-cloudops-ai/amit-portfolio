---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Amit Madakatti — Cloud & DevOps Engineer"
  description="Amit Madakatti — Cloud & DevOps Engineer building reliable cloud infrastructure and platforms."
>
  <main class="hero-page">
    <section class="hero-section" aria-labelledby="hero-title">
      <header class="hero-nav">
        <a class="nav-left" href="/" aria-label="Amit Madakatti home">Amit P Madakatti</a>
        <nav class="nav-right" aria-label="Main navigation">
          <a href="#work">Work</a>
          <a href="/about/">About</a>
          <a href="mailto:amitpm.work@gmail.com" class="project-pill">Start a project <span>↗</span></a>
        </nav>
      </header>

      <div class="hero-main">
        <p class="hero-subtitle-left">Cloud & DevOps Engineer<br />building dependable systems</p>
        <div class="hero-status-right">
          <div class="status-badge"><span class="status-dot"></span><span>Available for opportunities</span></div>
          <span class="location-text">Based in Ranebennur, India</span>
        </div>

        <div class="giant-name-layer" aria-hidden="true">
          <span>AMIT MADAKATTI</span>
        </div>

        <figure class="portrait-card-wrapper">
          <div class="portrait-card">
            <img
              src="/images/amit-portrait-placeholder.svg"
              alt="Portrait placeholder for Amit Madakatti"
              fetchpriority="high"
            />
          </div>
        </figure>
      </div>

      <div class="hero-footer">
        <p class="hero-desc">
          I design and engineer robust cloud infrastructure and platforms for digital products — and stay involved until they ship.
        </p>
        <a href="/about/" class="about-circle-btn" aria-label="Read about Amit">
          <span>About me</span><span class="about-arrow">↗</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
