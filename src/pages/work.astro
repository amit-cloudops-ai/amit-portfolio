---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Work — Amit Madakatti | Cloud & DevOps Engineer" description="Selected cloud infrastructure, platform engineering, Kubernetes, GitOps and AWS projects by Amit Madakatti.">
  <main class="work-page">
    <header class="work-page-nav">
      <a class="work-page-wordmark" href="/" aria-label="Amit Madakatti home">Amit Madakatti</a>
      <nav aria-label="Main navigation">
        <a href="/work/" aria-current="page">Work</a>
        <a href="/about/">About</a>
        <a class="work-page-talk" href="mailto:amitpm.work@gmail.com">Start a conversation</a>
      </nav>
      <details class="work-page-menu">
        <summary aria-label="Open page menu"><span></span><span></span></summary>
        <div class="work-page-menu-panel">
          <a href="/">Home <span>01</span></a>
          <a href="/work/">Work <span>02</span></a>
          <a href="/about/">About <span>03</span></a>
          <a href="/#skills">Skills <span>04</span></a>
          <a href="/#contact">Contact <span>05</span></a>
        </div>
      </details>
    </header>

    <section class="work-page-intro" aria-labelledby="work-page-title">
      <p class="work-page-kicker">SELECTED PROJECTS / 2024—26</p>
      <h1 id="work-page-title">Work<span>.</span></h1>
      <p class="work-page-lead">Cloud infrastructure, platform engineering and delivery systems built to make software easier to ship and operate.</p>
      <div class="work-filters" role="group" aria-label="Filter projects">
        <button class="work-filter is-active" type="button" data-filter="all" aria-pressed="true">All</button>
        <button class="work-filter" type="button" data-filter="platform" aria-pressed="false">Platform</button>
        <button class="work-filter" type="button" data-filter="cloud" aria-pressed="false">Cloud</button>
        <button class="work-filter" type="button" data-filter="delivery" aria-pressed="false">Delivery</button>
      </div>
    </section>

    <section class="work-archive" aria-label="Project archive">
      <a class="work-archive-row" href="https://github.com/amit-cloudops-ai/progressive-delivery-eks-platform" target="_blank" rel="noopener noreferrer" data-category="platform delivery">
        <span class="archive-title">Progressive Delivery Platform</span>
        <span class="archive-description">An EKS platform combining GitOps, canary analysis, progressive traffic shifting and automated rollback.</span>
        <span class="archive-meta"><span>Platform · Kubernetes</span><span>2026</span></span>
        <span class="archive-arrow" aria-hidden="true">↗</span>
      </a>
      <a class="work-archive-row" href="https://github.com/amit-cloudops-ai/hrms-onboarding-service" target="_blank" rel="noopener noreferrer" data-category="cloud">
        <span class="archive-title">Employee Onboarding &amp; Identity</span>
        <span class="archive-description">An AWS onboarding workflow connecting employee identity, orchestration and document handling.</span>
        <span class="archive-meta"><span>Serverless · Identity</span><span>2025</span></span>
        <span class="archive-arrow" aria-hidden="true">↗</span>
      </a>
      <a class="work-archive-row" href="https://github.com/amit-cloudops-ai/Devops-3-tire-project-001" target="_blank" rel="noopener noreferrer" data-category="cloud platform">
        <span class="archive-title">Three-Tier AWS Application</span>
        <span class="archive-description">A segmented VPC architecture separating the public entry point, application runtime and private data layer.</span>
        <span class="archive-meta"><span>Cloud · Networking</span><span>2025</span></span>
        <span class="archive-arrow" aria-hidden="true">↗</span>
      </a>
      <a class="work-archive-row" href="https://github.com/amit-cloudops-ai/https-github.com-Amitpm8-aws-zero-downtime-deployment" target="_blank" rel="noopener noreferrer" data-category="cloud delivery">
        <span class="archive-title">Zero-Downtime API Deployments</span>
        <span class="archive-description">Blue-green Lambda environments, canary traffic shifting and CloudWatch alarms for safer API releases.</span>
        <span class="archive-meta"><span>Release · Serverless</span><span>2025</span></span>
        <span class="archive-arrow" aria-hidden="true">↗</span>
      </a>
    </section>

    <section class="work-credentials" aria-labelledby="credentials-title">
      <div class="credentials-heading">
        <p class="work-page-kicker">LEARNING / CREDENTIALS</p>
        <h2 id="credentials-title">Certification<span>.</span></h2>
      </div>
      <div class="credential-archive-row">
        <div>
          <p class="credential-issuer">AMAZON WEB SERVICES</p>
          <h3>AWS Certified Cloud Practitioner</h3>
        </div>
        <span class="credential-progress">IN PROGRESS</span>
      </div>
    </section>

    <section class="work-contact" id="contact" aria-labelledby="work-contact-title">
      <div class="work-contact-intro">
        <div class="work-contact-avatar"><img src="/images/amit-hero.webp" alt="" loading="lazy" /></div>
        <p>Have a cloud project<br />in mind?</p>
      </div>
      <h2 id="work-contact-title">Start a <span>project</span></h2>
      <div class="work-contact-action">
        <p>Tell me what you’re building and when you need it. I’ll get back to you as soon as I can.</p>
        <div>
          <a class="work-contact-email" href="mailto:amitpm.work@gmail.com">amitpm.work@gmail.com <span aria-hidden="true">↗</span></a>
          <p class="work-contact-link">Prefer LinkedIn? <a href="https://www.linkedin.com/in/amitpm8/" target="_blank" rel="noreferrer">Let’s connect.</a></p>
        </div>
      </div>
      <footer class="work-contact-footer">
        <nav aria-label="Footer navigation">
          <a href="/">Home</a><a href="/work/">Work</a><a href="/about/">About</a>
        </nav>
        <nav class="footer-social-links" aria-label="Social links">
          <a class="footer-social-link" href="https://www.linkedin.com/in/amitpm8/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.34H4.96V9.02h2.97v9.32ZM6.45 7.75a1.72 1.72 0 1 1 0-3.44 1.72 1.72 0 0 1 0 3.44Zm11.89 10.59h-2.96v-4.53c0-1.08-.02-2.47-1.51-2.47-1.52 0-1.75 1.18-1.75 2.39v4.61H9.16V9.02h2.84v1.27h.04c.4-.73 1.36-1.5 2.8-1.5 3 0 3.5 1.97 3.5 4.53v5.02Z"/></svg><span>LinkedIn</span><span aria-hidden="true">↗</span>
          </a>
          <a class="footer-social-link" href="mailto:amitpm.work@gmail.com" aria-label="Email Amit">
            <img src="https://cdn.simpleicons.org/gmail/EA4335" alt="" loading="lazy" /><span>Email</span><span aria-hidden="true">↗</span>
          </a>
          <a class="footer-social-link" href="https://github.com/amit-cloudops-ai" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.1c-3.1.67-3.76-1.32-3.76-1.32-.5-1.28-1.23-1.62-1.23-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 1.7 2.62 1.21 3.26.93.1-.72.39-1.21.71-1.49-2.48-.28-5.09-1.24-5.09-5.52 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.05 1.14a10.6 10.6 0 0 1 5.55 0c2.12-1.44 3.05-1.14 3.05-1.14.61 1.54.23 2.68.12 2.96.71.78 1.14 1.78 1.14 3 0 4.29-2.61 5.24-5.1 5.52.4.35.76 1.03.76 2.08v3.05c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"/></svg><span>GitHub</span><span aria-hidden="true">↗</span>
          </a>
        </nav>
        <span>© 2026 Amit Madakatti</span>
      </footer>
    </section>
  </main>

  <script>
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.work-filter');
    const projectRows = document.querySelectorAll<HTMLElement>('.work-archive-row');
    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter ?? 'all';
        filterButtons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        projectRows.forEach((row) => {
          const categories = (row.dataset.category ?? '').split(' ');
          row.hidden = filter !== 'all' && !categories.includes(filter);
        });
      });
    });

    const workMenu = document.querySelector<HTMLElement>('.work-page-menu');
    const workIntro = document.querySelector<HTMLElement>('.work-page-intro');
    if (workMenu && workIntro && 'IntersectionObserver' in window) {
      const menuObserver = new IntersectionObserver(([entry]) => {
        workMenu.classList.toggle('is-visible', !entry.isIntersecting);
      }, { threshold: 0.08 });
      menuObserver.observe(workIntro);
    }
  </script>

  <style>
    .work-page{background:#fff;color:#211c1b}
    .work-page-nav{position:relative;display:flex;align-items:center;justify-content:space-between;min-height:82px;padding:32px 2.1vw 0;z-index:10}
    .work-page-wordmark{font-size:16px;font-weight:600;letter-spacing:-.045em}
    .work-page-nav nav{display:flex;align-items:center;gap:44px;font-size:16px;font-weight:600}
    .work-page-nav nav a{transition:opacity .2s ease}
    .work-page-nav nav a:hover{opacity:.58}
    .work-page-talk{padding:13px 22px;border:1px solid #c9c2bc;border-radius:99px}
    .work-page-menu{position:fixed;top:24px;right:2.1vw;z-index:1000;opacity:0;pointer-events:none;transform:translateY(-8px);transition:opacity .25s ease,transform .25s ease}
    .work-page-menu.is-visible{opacity:1;pointer-events:auto;transform:translateY(0)}
    .work-page-menu summary{display:grid;width:58px;height:58px;place-content:center;gap:6px;border-radius:50%;background:#211c1b;cursor:pointer;list-style:none}
    .work-page-menu summary::-webkit-details-marker{display:none}
    .work-page-menu summary span{display:block;width:19px;height:1px;background:#fff}
    .work-page-menu-panel{position:absolute;top:68px;right:0;width:210px;padding:12px 18px;background:#211c1b;color:#fff;border-radius:12px;box-shadow:0 12px 32px #211c1b24}
    .work-page-menu-panel a{display:flex;justify-content:space-between;padding:13px 0;border-bottom:1px solid #ffffff25;font-size:14px}
    .work-page-menu-panel a:last-child{border:0}
    .work-page-menu-panel span{color:#b9aaa1;font-size:11px}
    .work-page-intro{padding:clamp(42px,6.2vw,88px) 2.6vw clamp(48px,6vw,78px)}
    .work-page-kicker{margin:0 0 22px;color:#817875;font-size:11px;font-weight:700;letter-spacing:.14em}
    .work-page-intro h1{margin:0;font-size:clamp(76px,10.5vw,148px);font-weight:600;line-height:.86;letter-spacing:-.095em}
    .work-page-intro h1 span,.credentials-heading h2 span{color:#a83b2b}
    .work-page-lead{max-width:570px;margin:24px 0 34px;color:#4e4742;font-size:clamp(17px,1.4vw,20px);line-height:1.5}
    .work-filters{display:flex;flex-wrap:wrap;gap:9px}
    .work-filter{min-height:42px;padding:0 20px;border:1px solid #ddd7d1;border-radius:99px;background:#fff;color:#211c1b;font:600 13px/1 Manrope,sans-serif;cursor:pointer;transition:background .2s,color .2s,border-color .2s}
    .work-filter:hover,.work-filter.is-active{border-color:#211c1b;background:#211c1b;color:#fff}
    .work-archive{margin:0 2.6vw;border-top:1px solid #e4e0dc}
    .work-archive-row{display:grid;grid-template-columns:minmax(250px,1.05fr) minmax(220px,1fr) minmax(170px,.6fr) 24px;align-items:center;gap:28px;min-height:142px;padding:24px 0;border-bottom:1px solid #ded9d4;transition:padding .25s ease,background .25s ease}
    .work-archive-row:hover{padding-right:14px;padding-left:14px;background:#faf9f7}
    .work-archive-row[hidden]{display:none}
    .archive-title{font-size:clamp(30px,3.25vw,48px);font-weight:550;line-height:1.04;letter-spacing:-.065em}
    .archive-description{max-width:360px;color:#625a55;font-size:16px;line-height:1.45}
    .archive-meta{display:flex;justify-content:space-between;gap:14px;color:#716963;font-size:12px;line-height:1.4}
    .archive-arrow{justify-self:end;display:grid;width:30px;height:30px;place-items:center;border:1px solid #c9c2bc;border-radius:50%;font-size:16px;transition:background .2s,color .2s,transform .2s}
    .work-archive-row:hover .archive-arrow{background:#a83b2b;border-color:#a83b2b;color:#fff;transform:translate(2px,-2px)}
    .work-credentials{padding:clamp(84px,10vw,136px) 2.6vw clamp(78px,9vw,120px)}
    .credentials-heading h2{margin:0;font-size:clamp(52px,7vw,92px);font-weight:600;line-height:.9;letter-spacing:-.085em}
    .credentials-heading .work-page-kicker{margin-bottom:20px}
    .credential-archive-row{display:flex;justify-content:space-between;align-items:center;gap:30px;margin-top:42px;padding:28px 0;border-top:1px solid #ded9d4;border-bottom:1px solid #ded9d4}
    .credential-issuer{margin:0 0 12px;color:#817875;font-size:11px;font-weight:700;letter-spacing:.13em}
    .credential-archive-row h3{margin:0;font-size:clamp(25px,3vw,38px);font-weight:550;line-height:1.12;letter-spacing:-.055em}
    .credential-progress{color:#a83b2b;font-size:12px;font-weight:800;letter-spacing:.12em}
    .work-contact{position:relative;margin:40px 1px 0;padding:clamp(112px,11vw,166px) 2.6vw 24px;overflow:hidden;border-radius:clamp(76px,8.2vw,142px) clamp(76px,8.2vw,142px) 0 0;background:#1d1816;color:#fff}
    .work-contact-intro{display:flex;align-items:center;gap:14px;max-width:1600px;margin:0 auto}
    .work-contact-avatar{width:58px;height:58px;flex:0 0 58px;overflow:hidden;border-radius:50%;background:#65564c}
    .work-contact-avatar img{width:100%;height:100%;object-fit:cover;object-position:center 25%}
    .work-contact-intro p{margin:0;color:#fff;font-size:clamp(20px,2vw,28px);font-weight:600;line-height:1.15;letter-spacing:-.04em}
    .work-contact h2{max-width:1600px;margin:clamp(58px,7vw,94px) auto 0;font-size:clamp(78px,12.8vw,184px);font-weight:600;line-height:.82;letter-spacing:-.095em}
    .work-contact-action{display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,.8fr);align-items:end;gap:5vw;max-width:1600px;margin:clamp(42px,6vw,72px) auto clamp(76px,9vw,112px)}
    .work-contact-action>p{max-width:440px;margin:0;color:#e0d8d2;font-size:17px;line-height:1.55}
    .work-contact-email{display:flex;width:max-content;max-width:100%;align-items:center;justify-content:center;gap:18px;padding:16px 25px;border:1px solid #8b817b;border-radius:100px;color:#fff;font-size:16px;font-weight:600}
    .work-contact-email span{font-size:18px}
    .work-contact-link{margin:19px 0 0;color:#a99f98;font-size:13px;text-align:right}
    .work-contact-link a{color:#fff;text-decoration:underline;text-underline-offset:3px}
    .work-contact-footer{display:grid;grid-template-columns:1fr 1fr auto;align-items:center;gap:24px;max-width:1600px;margin:0 auto;padding:22px 0 8px;border-top:1px solid #403936}
    .work-contact-footer nav{display:flex;gap:26px}
    .work-contact-footer a,.work-contact-footer>span{color:#d1c8c1;font-size:12px;line-height:1.4}
    .work-contact-footer a:hover{color:#fff}
    .work-contact-footer>span{color:#928780;text-align:right}
    @media(max-width:900px){
      .work-page-nav{min-height:82px;padding:24px 5vw 0}
      .work-page-nav nav{gap:22px}
      .work-page-menu{right:5vw}
      .work-page-intro{padding-right:5vw;padding-left:5vw}
      .work-archive{margin-right:5vw;margin-left:5vw}
      .work-archive-row{grid-template-columns:minmax(190px,.9fr) minmax(190px,1fr) minmax(135px,.65fr) 24px;gap:18px}
      .archive-title{font-size:clamp(27px,3.4vw,38px)}
      .archive-description{font-size:14px}
      .archive-meta{font-size:11px}
      .work-credentials{padding-right:5vw;padding-left:5vw}
      .work-contact{padding-right:5vw;padding-left:5vw}
      .work-contact h2{font-size:clamp(70px,11vw,120px)}
    }
    @media(max-width:700px){
      .work-page-nav{min-height:72px;padding:16px 20px 0}
      .work-page-wordmark{font-size:14px}
      .work-page-nav nav{gap:16px;font-size:13px}
      .work-page-talk{display:none}
      .work-page-menu{top:18px;right:19px}
      .work-page-menu summary{width:46px;height:46px}
      .work-page-menu-panel{top:54px}
      .work-page-intro{padding:48px 20px 42px}
      .work-page-kicker{margin-bottom:18px;font-size:10px}
      .work-page-intro h1{font-size:clamp(68px,16vw,94px)}
      .work-page-lead{max-width:440px;margin:20px 0 27px;font-size:17px}
      .work-filter{min-height:40px;padding:0 17px;font-size:12px}
      .work-archive{margin:0 20px}
      .work-archive-row{grid-template-columns:minmax(0,1fr) auto;gap:10px 14px;min-height:0;padding:22px 0}
      .archive-title{grid-column:1;font-size:clamp(29px,8vw,38px)}
      .archive-description{grid-column:1;max-width:440px;font-size:15px;line-height:1.5}
      .archive-meta{grid-column:1;grid-row:3;justify-content:flex-start;gap:20px;font-size:11px}
      .archive-arrow{grid-column:2;grid-row:1;width:28px;height:28px}
      .work-credentials{padding:78px 20px 78px}
      .credentials-heading h2{font-size:clamp(48px,12vw,68px)}
      .credential-archive-row{align-items:flex-start;flex-direction:column;gap:20px;margin-top:28px;padding:22px 0}
      .credential-archive-row h3{font-size:clamp(25px,7vw,32px)}
      .credential-progress{font-size:11px}
      .work-contact{margin-top:20px;padding:68px 20px 22px;border-radius:42px 42px 0 0}
      .work-contact-avatar{width:46px;height:46px;flex-basis:46px}
      .work-contact-intro p{font-size:18px}
      .work-contact h2{margin-top:56px;font-size:clamp(60px,14vw,92px);line-height:.88}
      .work-contact-action{display:flex;flex-direction:column;align-items:stretch;gap:28px;margin:32px auto 58px}
      .work-contact-action>p{font-size:15px}
      .work-contact-email{width:100%;justify-content:space-between;padding:14px 18px;font-size:13px}
      .work-contact-link{text-align:left}
      .work-contact-footer{grid-template-columns:1fr;gap:17px;padding-top:18px}
      .work-contact-footer nav{gap:22px}
      .work-contact-footer>span{text-align:left}
    }
    @media(prefers-reduced-motion:reduce){
      .work-filter,.work-archive-row,.archive-arrow{transition:none}
    }

    .footer-social-links{display:flex;align-items:center;gap:24px;flex-wrap:wrap}
    .footer-social-link{display:inline-flex;align-items:center;gap:8px;transition:opacity .2s ease,transform .2s ease}
    .footer-social-link:hover{opacity:.72;transform:translateY(-2px)}
    .footer-social-link svg,.footer-social-link img{width:16px;height:16px;display:block;flex:0 0 16px}
    .footer-social-link span:last-child{color:#c75a43}
  </style>
</BaseLayout>
