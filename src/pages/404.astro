---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found — Amit Madakatti" description="The page you're looking for could not be found. Explore Amit Madakatti's cloud and DevOps engineering portfolio.">
  <main class="not-found-page">
    <header><a href="/" aria-label="Amit Madakatti home">Amit Madakatti</a><a href="/work/">WORK ↗</a></header>
    <section>
      <p class="not-found-kicker">404 / PAGE NOT FOUND</p>
      <h1>Wrong<br /><span>turn.</span></h1>
      <p class="not-found-copy">This page doesn't exist or may have moved. Let's get you back to the work.</p>
      <div class="not-found-actions"><a href="/">Back home <span>↗</span></a><a href="/work/">Explore projects <span>↗</span></a></div>
    </section>
    <footer>© 2026 Amit Madakatti <a href="mailto:amitpm.work@gmail.com">GET IN TOUCH ↗</a></footer>
  </main>
  <style>
    .not-found-page{min-height:100svh;display:flex;flex-direction:column;justify-content:space-between;padding:28px 5vw 24px;background:#f2f0ec;color:#211c1b}
    .not-found-page header,.not-found-page footer{display:flex;align-items:center;justify-content:space-between;gap:20px}
    .not-found-page header{font-size:14px;font-weight:650}
    .not-found-page header a:last-child,.not-found-page footer a{font-size:10px;font-weight:800;letter-spacing:.14em}
    .not-found-page section{padding:clamp(70px,12vh,130px) 0}
    .not-found-kicker{margin:0 0 25px;color:#817875;font-size:11px;font-weight:800;letter-spacing:.16em}
    .not-found-page h1{margin:0;font-size:clamp(100px,20vw,260px);font-weight:650;line-height:.76;letter-spacing:-.11em}
    .not-found-page h1 span{color:#a83b2b}
    .not-found-copy{max-width:420px;margin:42px 0 30px;color:#625a55;font-size:clamp(17px,1.5vw,20px);line-height:1.55}
    .not-found-actions{display:flex;gap:12px;flex-wrap:wrap}
    .not-found-actions a{display:inline-flex;align-items:center;gap:26px;padding:14px 20px;border:1px solid #c9c2bc;border-radius:99px;font-size:14px;font-weight:650}
    .not-found-actions a:first-child{background:#211c1b;color:#fff;border-color:#211c1b}
    .not-found-actions span{color:#c75a43}
    .not-found-page footer{padding-top:18px;border-top:1px solid #d5cfc8;color:#817875;font-size:11px}
    @media(max-width:600px){.not-found-page{padding:22px 20px}.not-found-page section{padding:80px 0}.not-found-page h1{font-size:clamp(104px,28vw,170px)}.not-found-copy{margin-top:30px;font-size:16px}.not-found-actions a{flex:1;justify-content:space-between;padding:13px 15px;font-size:13px}}
  </style>
</BaseLayout>
