---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About — Amit Madakatti | Cloud & DevOps Engineer" description="The story, experience and working principles behind Amit Madakatti's cloud and DevOps engineering work.">
  <main class="about-page">
    <header class="about-nav">
      <a class="about-wordmark" href="/" aria-label="Amit Madakatti home">Amit Madakatti</a>
      <nav aria-label="Main navigation">
        <a href="/work/">Work</a>
        <a href="/about/" aria-current="page">About</a>
        <a class="about-talk" href="mailto:amitpm.work@gmail.com">Start a conversation</a>
      </nav>
      <details class="about-menu">
        <summary aria-label="Open page menu"><span></span><span></span></summary>
        <div class="about-menu-panel">
          <a href="/">Home <span>01</span></a>
          <a href="/work/">Work <span>02</span></a>
          <a href="/about/">About <span>03</span></a>
          <a href="/#contact">Contact <span>04</span></a>
        </div>
      </details>
    </header>

    <section class="about-intro" aria-labelledby="about-title">
      <h1 id="about-title">About</h1>
      <p class="about-opening">I’m Amit Madakatti, a Cloud &amp; DevOps Engineer in Karnataka, India. I build automated, secure and reliable cloud infrastructure, with a focus on AWS, Kubernetes and platform engineering.</p>
      <div class="about-story-grid">
        <div class="about-story-copy">
          <p>I studied Metallurgical and Materials Engineering at NITK Surathkal. That foundation taught me to look closely at how systems behave, understand the material behind a process, and work methodically through complex problems.</p>
          <p>My path since then has taken me through manufacturing at BHEL, teaching mathematics, building ventures and working hands-on with cloud infrastructure. Each experience shaped the way I approach engineering: make the system understandable, make the process repeatable, and improve it with evidence.</p>
          <p>Today, I’m an AWS Cloud Intern at F13 Technologies. My work and personal projects focus on AWS, Kubernetes, infrastructure as code, GitOps, progressive delivery and observability.</p>
        </div>
        <figure class="about-portrait">
          <img src="/images/amit-hero.webp" alt="Portrait of Amit Madakatti" loading="eager" />
        </figure>
      </div>
    </section>

    <section class="about-experience" aria-labelledby="experience-title">
      <h2 id="experience-title">Experience</h2>
      <div class="experience-list">
        <article class="experience-row">
          <h3>Sep 2026 to now</h3>
          <p>AWS Cloud Intern</p>
          <span>F13 Technologies, Bengaluru</span>
        </article>
        <article class="experience-row">
          <h3>Sep 2025 to Jun 2026</h3>
          <p>Mathematics Teacher</p>
          <span>Kannur PU College</span>
        </article>
        <article class="experience-row">
          <h3>May 2024 to Jul 2024</h3>
          <p>Data Analytics Intern</p>
          <span>BHEL, Electronics Division</span>
        </article>
        <article class="experience-row">
          <h3>Dec 2021 to May 2025</h3>
          <p>B.Tech, Metallurgical &amp; Materials Engineering</p>
          <span>NITK Surathkal</span>
        </article>
      </div>
    </section>

    <section class="about-principles" aria-labelledby="principles-title">
      <h2 id="principles-title">How I work</h2>
      <div class="principle-list">
        <article class="principle-row">
          <h3>Understand the system.</h3>
          <p>Start with the architecture, constraints and failure modes before choosing a tool or adding another layer.</p>
        </article>
        <article class="principle-row">
          <h3>Automate the repeatable.</h3>
          <p>Use infrastructure as code, version control and delivery pipelines to make reliable processes repeatable.</p>
        </article>
        <article class="principle-row">
          <h3>Design for operations.</h3>
          <p>Build in observability, clear ownership and safe recovery paths so systems remain understandable after release.</p>
        </article>
      </div>
      <p class="about-signoff">Build carefully. Automate deliberately. Keep learning.</p>
    </section>

    <section class="contact-section about-contact" id="contact" aria-labelledby="contact-title">
      <div class="contact-intro-line">
        <div class="contact-avatar"><img src="/images/amit-hero.webp" alt="" loading="lazy" /></div>
        <p>Have a cloud project<br />in mind?</p>
      </div>
      <h2 id="contact-title">Start a <span>project</span></h2>
      <div class="contact-action-row">
        <p class="contact-prompt">Tell me what you’re building and when you need it. I’ll get back to you as soon as I can.</p>
        <div class="contact-action">
          <a class="contact-email" href="mailto:amitpm.work@gmail.com">amitpm.work@gmail.com <span aria-hidden="true">↗</span></a>
          <p>Prefer LinkedIn? <a href="https://www.linkedin.com/in/amitpm8/" target="_blank" rel="noreferrer">Let’s connect.</a></p>
        </div>
      </div>
      <footer class="contact-footer">
        <nav aria-label="Footer navigation">
          <a href="/work/">Work</a>
          <a href="/about/">About</a>
        </nav>
        <nav aria-label="Social links">
          <a href="https://www.linkedin.com/in/amitpm8/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
          <a href="https://github.com/amit-cloudops-ai" target="_blank" rel="noreferrer">GitHub ↗</a>
        </nav>
        <span>© 2026 Amit Madakatti</span>
      </footer>
    </section>
  </main>
  <script>
    const aboutMenu = document.querySelector<HTMLElement>('.about-menu');
    const aboutIntro = document.querySelector<HTMLElement>('.about-intro');
    if (aboutMenu && aboutIntro && 'IntersectionObserver' in window) {
      const aboutMenuObserver = new IntersectionObserver(([entry]) => {
        aboutMenu.classList.toggle('is-visible', !entry.isIntersecting);
      }, { threshold: 0.08 });
      aboutMenuObserver.observe(aboutIntro);
    }
  </script>
  <style>
    .about-page{background:#fff;color:#211c1b}
    .about-nav{position:relative;display:flex;align-items:center;justify-content:space-between;min-height:82px;padding:32px 2.1vw 0;z-index:10}
    .about-wordmark{font-size:16px;font-weight:600;letter-spacing:-.045em}
    .about-nav nav{display:flex;align-items:center;gap:44px;padding-right:0;font-size:16px;font-weight:600}
    .about-nav nav a{transition:opacity .2s ease}
    .about-nav nav a:hover{opacity:.58}
    .about-talk{padding:13px 22px;border:1px solid #c9c2bc;border-radius:99px}
    .about-menu{position:fixed;top:24px;right:2.1vw;z-index:1000;opacity:0;pointer-events:none;transform:translateY(-8px);transition:opacity .25s ease,transform .25s ease}
    .about-menu.is-visible{opacity:1;pointer-events:auto;transform:translateY(0)}
    .about-menu summary{display:grid;width:58px;height:58px;place-content:center;gap:6px;border-radius:50%;background:#211c1b;cursor:pointer;list-style:none}
    .about-menu summary::-webkit-details-marker{display:none}
    .about-menu summary span{display:block;width:17px;height:1px;background:#fff}
    .about-menu-panel{position:absolute;top:68px;right:0;width:210px;padding:12px 18px;background:#211c1b;color:#fff;border-radius:12px;box-shadow:0 12px 32px #211c1b24}
    .about-menu-panel a{display:flex;justify-content:space-between;padding:13px 0;border-bottom:1px solid #ffffff25;font-size:14px}
    .about-menu-panel a:last-child{border:0}
    .about-menu-panel span{color:#b9aaa1;font-size:11px}
    .about-intro,.about-experience,.about-principles{padding-right:3vw;padding-left:3vw}
    .about-intro{padding-top:clamp(34px,5vw,72px);padding-bottom:clamp(70px,9vw,126px)}
    .about-intro h1{margin:0 0 25px;font-size:clamp(76px,11vw,154px);font-weight:600;line-height:.86;letter-spacing:-.095em}
    .about-opening{max-width:780px;margin:0;color:#302a27;font-size:clamp(18px,1.7vw,23px);line-height:1.48}
    .about-story-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,.82fr);align-items:start;gap:clamp(50px,8vw,128px);margin-top:clamp(52px,7vw,88px)}
    .about-story-copy{max-width:690px}
    .about-story-copy p{margin:0 0 22px;color:#39322e;font-size:clamp(16px,1.25vw,18px);line-height:1.65}
    .about-portrait{width:100%;max-width:560px;height:clamp(390px,48vw,610px);justify-self:end;margin:0;overflow:hidden;border-radius:26px;background:#e8e2db}
    .about-portrait img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 35%}
    .about-experience,.about-principles{padding-top:clamp(54px,7vw,96px);padding-bottom:clamp(70px,9vw,124px)}
    .about-experience h2,.about-principles h2{margin:0 0 34px;font-size:clamp(42px,5.2vw,68px);font-weight:600;line-height:1;letter-spacing:-.075em}
    .experience-list,.principle-list{border-top:1px solid #e4e0dc}
    .experience-row{display:grid;grid-template-columns:minmax(210px,.75fr) minmax(220px,1fr) minmax(180px,.75fr);align-items:center;gap:28px;min-height:86px;padding:18px 0;border-bottom:1px solid #e4e0dc}
    .experience-row h3,.principle-row h3{margin:0;font-size:clamp(20px,2.2vw,27px);font-weight:550;line-height:1.18;letter-spacing:-.05em}
    .experience-row p{margin:0;font-size:clamp(16px,1.35vw,18px);line-height:1.4}
    .experience-row>span{color:#716963;font-size:14px;text-align:right}
    .about-principles{padding-top:clamp(60px,8vw,110px)}
    .principle-row{display:grid;grid-template-columns:minmax(240px,.75fr) minmax(0,1.25fr);align-items:center;gap:38px;min-height:112px;padding:24px 0;border-bottom:1px solid #e4e0dc}
    .principle-row p{max-width:650px;margin:0;color:#514943;font-size:clamp(16px,1.3vw,18px);line-height:1.55}
    .about-signoff{margin:30px 0 0;color:#716963;font-size:15px;line-height:1.5}
    .about-contact{margin-top:0}
    @media(max-width:900px){
      .about-nav{min-height:82px;padding:24px 5vw 0}
      .about-nav nav{gap:22px;padding-right:0}
      .about-menu{right:5vw}
      .about-story-grid{grid-template-columns:minmax(0,1fr) minmax(260px,.85fr);gap:5vw}
      .about-portrait{height:440px}
      .experience-row{grid-template-columns:minmax(170px,.75fr) minmax(180px,1fr) minmax(150px,.8fr);gap:16px}
      .experience-row>span{font-size:13px}
    }
    @media(max-width:700px){
      .about-nav{min-height:72px;padding:16px 20px 0}
      .about-wordmark{font-size:14px}
      .about-nav nav{gap:16px;padding-right:0;font-size:13px}
      .about-talk{display:none}
      .about-menu{top:18px;right:19px}
      .about-menu summary{width:46px;height:46px}
      .about-menu-panel{top:54px}
      .about-intro,.about-experience,.about-principles{padding-right:20px;padding-left:20px}
      .about-intro{padding-top:46px;padding-bottom:64px}
      .about-intro h1{margin-bottom:20px;font-size:clamp(64px,15vw,92px)}
      .about-opening{font-size:18px;line-height:1.5}
      .about-story-grid{display:flex;flex-direction:column;gap:22px;margin-top:36px}
      .about-story-copy p{margin-bottom:17px;font-size:16px;line-height:1.6}
      .about-portrait{width:100%;max-width:none;height:min(112vw,480px);border-radius:22px}
      .about-experience,.about-principles{padding-top:58px;padding-bottom:70px}
      .about-experience h2,.about-principles h2{margin-bottom:24px;font-size:clamp(38px,10vw,48px)}
      .experience-row{grid-template-columns:minmax(0,1fr) auto;gap:7px 14px;min-height:0;padding:19px 0}
      .experience-row h3{font-size:20px}
      .experience-row p{grid-column:1;font-size:16px}
      .experience-row>span{grid-column:2;grid-row:1 / span 2;align-self:center;max-width:145px;font-size:12px;line-height:1.4}
      .principle-row{grid-template-columns:1fr;gap:10px;min-height:0;padding:21px 0}
      .principle-row h3{font-size:21px}
      .principle-row p{font-size:16px;line-height:1.55}
      .about-signoff{font-size:14px}
    }
  </style>
</BaseLayout>
