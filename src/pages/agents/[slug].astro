---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { agents } from '../../data/agents';

export function getStaticPaths() {
  return agents.map((agent) => ({ params: { slug: agent.slug }, props: { agent } }));
}

const { agent } = Astro.props;
---
<BaseLayout title={agent.name + ' — Agent Blueprint | Amit Madakatti'} description={agent.summary}>
  <main class="agent-detail">
    <header class="agent-detail-nav">
      <a href="/" class="agent-detail-brand">Amit Madakatti</a>
      <a href="/#agents" class="agent-detail-back">← ALL AGENTS</a>
    </header>
    <section class="agent-detail-hero">
      <p class="agent-detail-kicker">AGENT BLUEPRINT / {agent.number} — {agent.category}</p>
      <h1>{agent.name}<span>.</span></h1>
      <p class="agent-detail-summary">{agent.summary}</p>
    </section>
    <section class="agent-detail-grid">
      <article><p class="agent-detail-label">01 / TOOL ACCESS</p><h2>Connected tools</h2><ul>{agent.tools.map((tool) => <li>{tool}</li>)}</ul></article>
      <article><p class="agent-detail-label">02 / PERMISSION BOUNDARY</p><h2>What it can touch</h2><p>{agent.boundary}</p></article>
      <article><p class="agent-detail-label">03 / HUMAN APPROVAL</p><h2>Where you stay in control</h2><p>{agent.approval}</p></article>
      <article class="agent-detail-demo"><p class="agent-detail-label">04 / BUILD NOTES &amp; DEMO</p><h2>Proof, not promises.</h2><p>{agent.demo}</p></article>
    </section>
    <footer class="agent-detail-footer"><a href="/#agents">← Back to the agent team</a><a href="https://www.linkedin.com/in/amitpm8/" target="_blank" rel="noreferrer">FOLLOW THE BUILD ↗</a></footer>
  </main>
  <style>
    .agent-detail{min-height:100vh;padding:26px 6.2vw 42px;background:#f2f0ec;color:#211c1b}
    .agent-detail-nav,.agent-detail-footer{display:flex;justify-content:space-between;align-items:center;gap:20px}
    .agent-detail-nav{font-size:13px;font-weight:700}
    .agent-detail-back,.agent-detail-footer a:last-child{font-size:9px;font-weight:800;letter-spacing:.13em}
    .agent-detail-hero{padding:clamp(85px,12vw,150px) 0 65px}
    .agent-detail-kicker,.agent-detail-label{color:#8a817a;font-size:9px;font-weight:800;letter-spacing:.15em}
    .agent-detail-hero h1{max-width:1100px;margin:28px 0 24px;font-size:clamp(64px,11vw,150px);font-weight:600;line-height:.86;letter-spacing:-.09em}
    .agent-detail-hero h1 span{color:#a83b2b}
    .agent-detail-summary{max-width:620px;margin:0;color:#746d68;font-size:clamp(16px,1.8vw,21px);line-height:1.55}
    .agent-detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1px solid #cfc9c1}
    .agent-detail-grid article{padding:28px 32px 34px 0;border-bottom:1px solid #cfc9c1}
    .agent-detail-grid article:nth-child(odd){border-right:1px solid #cfc9c1}
    .agent-detail-grid article:nth-child(even){padding-left:32px}
    .agent-detail-grid h2{margin:17px 0 14px;font-size:clamp(23px,2.6vw,34px);font-weight:600;letter-spacing:-.06em}
    .agent-detail-grid p:not(.agent-detail-label),.agent-detail-grid li{max-width:560px;color:#746d68;font-size:14px;line-height:1.65}
    .agent-detail-grid ul{margin:0;padding-left:18px}
    .agent-detail-grid li{padding:3px 0}
    .agent-detail-demo{grid-column:1/-1;border-right:0!important;padding-left:0!important}
    .agent-detail-footer{margin-top:28px;font-size:11px}
    .agent-detail-footer a:last-child{color:#a83b2b}
    @media(max-width:700px){
      .agent-detail{padding:20px 20px 30px}
      .agent-detail-hero{padding:94px 0 46px}
      .agent-detail-hero h1{font-size:clamp(58px,16vw,90px)}
      .agent-detail-summary{font-size:15px}
      .agent-detail-grid{grid-template-columns:1fr}
      .agent-detail-grid article,.agent-detail-grid article:nth-child(even){padding:23px 0 26px;border-right:0}
      .agent-detail-grid h2{font-size:26px}
      .agent-detail-grid p:not(.agent-detail-label),.agent-detail-grid li{font-size:13px}
      .agent-detail-demo{grid-column:auto}
      .agent-detail-footer{align-items:flex-start;flex-direction:column}
    }
  </style>
</BaseLayout>
