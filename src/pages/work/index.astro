---
import BaseLayout from '../../layouts/BaseLayout.astro';
const projects = [
  { number: '01', type: 'KUBERNETES / PLATFORM ENGINEERING', title: 'Progressive Delivery Platform', description: 'A GitOps-driven EKS platform for progressive delivery, traffic shifting and release health analysis.', image: '/images/projects/progressive-delivery-platform.svg', href: '/work/progressive-delivery/', stack: 'AWS · EKS · ARGO CD · TERRAFORM' },
  { number: '02', type: 'SERVERLESS / IDENTITY AUTOMATION', title: 'Employee Onboarding & Identity', description: 'An AWS onboarding system connecting employee identity, workflow orchestration and document handling.', image: '/images/projects/employee-onboarding-service.svg', href: '/work/employee-onboarding/', stack: 'AWS · COGNITO · STEP FUNCTIONS' },
  { number: '03', type: 'CLOUD NETWORKING / WEB ARCHITECTURE', title: 'Three-Tier AWS Application', description: 'A segmented AWS network separating the public entry point, application runtime and data layer.', image: '/images/projects/three-tier-web-app.svg', href: '/work/three-tier-aws/', stack: 'AWS · VPC · EC2 · RDS' },
  { number: '04', type: 'RELEASE ENGINEERING / SERVERLESS', title: 'Zero-Downtime API Deployments', description: 'Blue-green environments and controlled canary traffic for safer API releases.', image: '/images/projects/zero-downtime-api-deployment.svg', href: '/work/zero-downtime-api/', stack: 'API GATEWAY · LAMBDA · CLOUDWATCH' }
];
---
<BaseLayout title="Selected Work — Amit Madakatti" description="Cloud infrastructure, platform engineering and release automation projects by Amit Madakatti.">
  <main class="work-archive">
    <header class="archive-nav">
      <a href="/" class="archive-brand">Amit Madakatti</a>
      <a href="/" class="archive-back">Back to home ↗</a>
    </header>
    <section class="archive-intro">
      <p class="archive-kicker">PROJECT INDEX / 2024—26</p>
      <h1>Work that<br /><span>keeps running.</span></h1>
      <p class="archive-description">A closer look at the infrastructure, delivery systems and cloud applications I’ve designed and built.</p>
    </section>
    <section class="archive-grid" aria-label="Project case studies">
      {projects.map((project) => (
        <a class="archive-card" href={project.href}>
          <div class="archive-image"><img src={project.image} alt={project.title + ' architecture diagram'} loading="lazy" /></div>
          <div class="archive-meta"><span>{project.number} / {project.type}</span><span>{project.stack}</span></div>
          <h2>{project.title} <span aria-hidden="true">↗</span></h2>
          <p>{project.description}</p>
        </a>
      ))}
    </section>
    <footer class="archive-footer"><span>HAVE A SYSTEM TO BUILD?</span><a href="mailto:amitpm.work@gmail.com">Let’s talk ↗</a></footer>
  </main>
  <style>
    .work-archive{min-height:100vh;padding:26px 6.2vw 40px;background:#f2f0ec;color:#211c1b}
    .archive-nav{display:flex;justify-content:space-between;align-items:center;font-size:14px;font-weight:700}
    .archive-back{border-bottom:1px solid #aaa29a;padding-bottom:5px}
    .archive-intro{padding:clamp(80px,12vw,160px) 0 70px}
    .archive-kicker{font-size:10px;font-weight:800;letter-spacing:.16em;color:#8a817a}
    .archive-intro h1{margin:28px 0 26px;font-size:clamp(72px,12vw,170px);font-weight:600;line-height:.82;letter-spacing:-.095em}
    .archive-intro h1 span{color:#a83b2b}
    .archive-description{max-width:430px;margin:0;color:#746d68;font-size:16px;line-height:1.6}
    .archive-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:56px 28px}
    .archive-card{min-width:0}
    .archive-image{aspect-ratio:1.55;overflow:hidden;border-radius:14px;background:#e5e0d8}
    .archive-image img{display:block;width:100%;height:100%;object-fit:contain;transition:transform .55s cubic-bezier(.2,.7,.2,1)}
    .archive-card:hover .archive-image img{transform:scale(1.035)}
    .archive-meta{display:flex;justify-content:space-between;gap:15px;margin-top:18px;color:#8a817a;font-size:9px;font-weight:800;letter-spacing:.1em}
    .archive-meta span:last-child{text-align:right}
    .archive-card h2{display:flex;justify-content:space-between;gap:20px;margin:15px 0 8px;font-size:clamp(25px,3vw,42px);font-weight:600;line-height:1.05;letter-spacing:-.065em}
    .archive-card h2 span{color:#a83b2b;font-size:.7em}
    .archive-card p{max-width:440px;margin:0;color:#746d68;font-size:13px;line-height:1.55}
    .archive-footer{display:flex;justify-content:space-between;margin-top:100px;padding-top:22px;border-top:1px solid #cfc9c1;font-size:10px;font-weight:800;letter-spacing:.13em}
    .archive-footer a{color:#a83b2b}
    @media(max-width:700px){.work-archive{padding:20px 20px 30px}.archive-intro{padding:100px 0 50px}.archive-intro h1{font-size:clamp(64px,17vw,94px)}.archive-description{font-size:14px}.archive-grid{grid-template-columns:1fr;gap:42px}.archive-meta{font-size:8px}.archive-card h2{font-size:30px}.archive-footer{margin-top:70px}}
  </style>
</BaseLayout>
