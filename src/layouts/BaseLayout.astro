---
const { title = 'Amit Madakatti — Cloud & DevOps Engineer', description = 'Cloud, DevOps and platform engineering portfolio.' } = Astro.props;
import '../styles/global.css';
const siteUrl = Astro.site?.toString() ?? 'https://amit-portfolio.amitpm-github.workers.dev';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Amit Madakatti',
  jobTitle: 'Cloud & DevOps Engineer',
  url: siteUrl,
  email: 'mailto:amitpm.work@gmail.com',
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'Karnataka',
    addressCountry: 'IN'
  },
  sameAs: [
    'https://www.linkedin.com/in/amitpm8/',
    'https://github.com/amit-cloudops-ai'
  ],
  knowsAbout: [
    'Amazon Web Services',
    'Cloud Engineering',
    'DevOps',
    'Kubernetes',
    'Platform Engineering',
    'Infrastructure as Code',
    'GitOps',
    'Observability',
    'Site Reliability Engineering'
  ]
};
---
<script is:inline>
  try {
    if (!sessionStorage.getItem('amit-portfolio-intro-seen')) {
      document.documentElement.classList.add('is-loading');
      sessionStorage.setItem('amit-portfolio-intro-seen', '1');
    }
  } catch {
    document.documentElement.classList.add('is-loading');
  }
</script>
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" /><title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Amit Madakatti" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://amit-portfolio.amitpm-github.workers.dev/images/amit-hero.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://amit-portfolio.amitpm-github.workers.dev/images/amit-hero.webp" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <slot name="head" />
  </head>
  <body>
    <div class="site-preloader" aria-hidden="true">
      <div class="preloader-main">
        <div class="preloader-monogram">AM<span>.</span></div>
        <p class="preloader-caption">Cloud systems / Built to run</p>
      </div>
      <div class="preloader-bottom">
        <span>Amit Madakatti / Portfolio</span>
        <div class="preloader-progress"><span></span></div>
        <span class="preloader-percent">00</span>
      </div>
    </div>
    <slot />

    <script>
      const tracks = document.querySelectorAll<HTMLElement>('.ticker-track');
      let previousY = window.scrollY;
      let direction: 'normal' | 'reverse' = 'normal';
      const setDirection = (next: 'normal' | 'reverse') => {
        if (next === direction) return;
        direction = next;
        tracks.forEach((track) => { track.style.animationDirection = direction; });
      };
      window.addEventListener('scroll', () => {
        const currentY = window.scrollY;
        if (Math.abs(currentY - previousY) > 1) setDirection(currentY > previousY ? 'normal' : 'reverse');
        previousY = currentY;
      }, { passive: true });
      window.addEventListener('wheel', (event) => {
        if (Math.abs(event.deltaY) > 1) setDirection(event.deltaY > 0 ? 'normal' : 'reverse');
      }, { passive: true });
    </script>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        if (!root.classList.contains('is-loading')) return;
        const loader = document.querySelector('.site-preloader');
        const bar = loader?.querySelector('.preloader-progress span');
        const counter = loader?.querySelector('.preloader-percent');
        if (!loader || !bar || !counter) {
          root.classList.remove('is-loading');
          return;
        }
        let value = 0;
        let frame = 0;
        let finished = false;
        const render = (next) => {
          value = Math.min(100, Math.max(value, next));
          bar.style.width = value + '%';
          counter.textContent = String(value).padStart(2, '0');
        };
        const start = performance.now();
        const tick = (now) => {
          if (finished) return;
          render(Math.min(92, Math.round(92 * (1 - Math.exp(-(now - start) / 1050)))));
          frame = requestAnimationFrame(tick);
        };
        frame = requestAnimationFrame(tick);
        const finish = () => {
          if (finished) return;
          finished = true;
          cancelAnimationFrame(frame);
          render(100);
          window.setTimeout(() => {
            root.classList.add('is-preloader-exit');
            window.setTimeout(() => {
              root.classList.remove('is-loading', 'is-preloader-exit');
              loader.remove();
            }, 500);
          }, 220);
        };
        window.addEventListener('load', finish, { once: true });
        window.setTimeout(finish, 5000);
        if (document.readyState === 'complete') finish();
      })();
    </script>
  </body>
</html>
